# Apache settings for the game on shared hosting. Copied to dist/ by the build.

# Never list folder contents.
Options -Indexes

# Always use HTTPS: plain HTTP requests are sent to the same address over HTTPS.
# HSTS is left out for now: if the certificate renewal ever failed, browsers would refuse the site.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # File names in assets/ contain a hash of their content, so they can be cached for a year.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The page itself is always fetched fresh, so a new version shows up at once.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Only this site's own files may run. No third-party scripts, fonts or trackers.
  # connect-src lists the game's own API (Azure Function App). Without it the browser blocks every call to the API.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://func-zombies-6254ydxyfcbzi.azurewebsites.net; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
  Header set X-Content-Type-Options "nosniff"
  # The browser remembers for a year to use only HTTPS here (HTTP already redirects). Only this subdomain.
  Header set Strict-Transport-Security "max-age=31536000"
  Header set Referrer-Policy "no-referrer"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript
</IfModule>
